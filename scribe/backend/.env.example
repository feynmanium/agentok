# Scribe API Configuration

# OpenAI API key for Whisper transcription
OPENAI_API_KEY=sk-your-key-here

# Hugging Face token for pyannote speaker diarization
# Get one at: https://huggingface.co/settings/tokens
# Accept the model license at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your-token-here

# Database URL (default: SQLite in data directory)
DATABASE_URL=sqlite+aiosqlite:///./data/scribe.db

# Server configuration
PORT=5005
DEBUG=false

# Optional: Use local Whisper instead of API
# USE_LOCAL_WHISPER=true
# LOCAL_WHISPER_MODEL=large-v3
